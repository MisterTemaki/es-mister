diff --git a/mister/package.sh b/mister/package.sh
index 4be7ea7..23f17ce 100755
--- a/mister/package.sh
+++ b/mister/package.sh
@@ -67,9 +67,15 @@ PROFILE=0
 SLOW_DUMPS=4
 
 # Rows of the screen drawn at a time through all its layers, so they stay in the processor's cache
-# between them (the memory is what a 1080p frame waits for). 16 by default; to compare, 8 or 32, or 0
-# (each band whole, as before), then logs/es-mister-stats.txt and logs/es-slow-frame-N.txt
-STRIP=16
+# between them (the memory is what a 1080p frame waits for). 8 by default (the fastest es-mister-bench
+# measured on the MiSTer); to compare, 4, 16 or 32, or 0 (each band whole), then
+# logs/es-mister-stats.txt and logs/es-slow-frame-N.txt
+STRIP=8
+
+# Bytes of memory the drawing asks for ahead of what it draws (the ARM's PLD), so it does not wait for
+# each line of memory in turn: 256 by default (es-mister-bench: a layer of a 1080p frame in 28 ms
+# instead of 49); 0: not asked for, to compare
+PLD=256
 
 # Folders of _Arcade that ES does not read (lower case, space apart). _alternatives has thousands of
 # other versions in hundreds of folders: reading it from the SD card adds many seconds to ES's start.
diff --git a/mister/scripts/es-mister.sh b/mister/scripts/es-mister.sh
index 6e733c0..81531ea 100755
--- a/mister/scripts/es-mister.sh
+++ b/mister/scripts/es-mister.sh
@@ -20,7 +20,8 @@ FPS=60
 BENCH=0
 PROFILE=0
 SLOW_DUMPS=4
-STRIP=16
+STRIP=8
+PLD=256
 ARCADE_SKIP="cores _organized mame hbmame _alternatives"
 INPUT_IGNORE="MiSTer virtual input,Zaparoo"
 GAMES_ROOTS="/media/fat /media/usb0 /media/usb1 /media/usb2 /media/usb3 /media/usb4 /media/usb5 /media/fat/cifs"
@@ -119,6 +120,8 @@ export ES_STARTUP_TRACE=$LOGS/es-startup.log
 export ES_ARCADE_SKIP="$ARCADE_SKIP"
 # rows drawn at a time through all the layers (they stay in the processor's cache); 0: a band at once
 export ES_SOFT_STRIP="$STRIP"
+# memory asked for ahead of the drawing (bytes); 0: not asked for
+export ES_SOFT_PLD="$PLD"
 # the first frames slow to draw, with each draw's time (logs/es-slow-frame-N.txt), to see what to make faster
 if [ "$SLOW_DUMPS" -gt 0 ] 2>/dev/null; then
 	rm -f "$LOGS"/es-slow-frame-*.txt
