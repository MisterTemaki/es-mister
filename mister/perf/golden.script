# Golden frames (run with ES_PERF_FIXED_STEP=1: every frame 1/60 s of ES's time, the same frames on every run).
# Starts on the SNES system (LastSystem=snes); the SNES view (grid or detailed) set by the harness.
settle 30000
wait 2000
shot g01-systems
key Right
wait 3000
shot g02-next-system
key Right
key Right
key Right
key Right
wait 3000
shot g03-five-ahead
key Left
key Left
key Left
key Left
key Left
wait 3000
shot g04-back-to-snes
key Return
wait 4000
shot g05-list
key Down
key Down
key Down
key Right
key Right
wait 3000
shot g06-list-moved
hold Down 3000
wait 3000
shot g07-list-scrolled
key "
wait 3000
shot g08-page
key Backspace
wait 3000
shot g09-options
key Escape
wait 2000
key Space
wait 3000
shot g10-menu
key Escape
wait 2000
key -
wait 3000
shot g11-search
key Escape
wait 2000
key Escape
wait 3000
shot g12-systems-again
quit
