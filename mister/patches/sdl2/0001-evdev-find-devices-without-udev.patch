+#ifndef SDL_USE_LIBUDEV
+#include <dirent.h>
+
+/* The keyboards, mice and touch devices in /dev/input, found as udev would find them */
+static void SDL_EVDEV_ScanDevices(void)
+{
+    DIR *dir = opendir("/dev/input");
+    struct dirent *entry;
+
+    if (!dir) {
+        return;
+    }
+
+    while ((entry = readdir(dir)) != NULL) {
+        char path[64];
+        unsigned long bitmask_ev[NBITS(EV_MAX)];
+        unsigned long bitmask_abs[NBITS(ABS_MAX)];
+        unsigned long bitmask_key[NBITS(KEY_MAX)];
+        unsigned long bitmask_rel[NBITS(REL_MAX)];
+        int fd, devclass;
+
+        if (SDL_strncmp(entry->d_name, "event", 5) != 0) {
+            continue;
+        }
+
+        SDL_snprintf(path, sizeof(path), "/dev/input/%s", entry->d_name);
+        fd = open(path, O_RDONLY | O_CLOEXEC);
+        if (fd < 0) {
+            continue;
+        }
+
+        SDL_zeroa(bitmask_ev);
+        SDL_zeroa(bitmask_abs);
+        SDL_zeroa(bitmask_key);
+        SDL_zeroa(bitmask_rel);
+        ioctl(fd, EVIOCGBIT(0, sizeof(bitmask_ev)), bitmask_ev);
+        ioctl(fd, EVIOCGBIT(EV_ABS, sizeof(bitmask_abs)), bitmask_abs);
+        ioctl(fd, EVIOCGBIT(EV_KEY, sizeof(bitmask_key)), bitmask_key);
+        ioctl(fd, EVIOCGBIT(EV_REL, sizeof(bitmask_rel)), bitmask_rel);
+        close(fd);
+
+        devclass = SDL_EVDEV_GuessDeviceClass(bitmask_ev, bitmask_abs, bitmask_key, bitmask_rel);
+        if (devclass & (SDL_UDEV_DEVICE_KEYBOARD | SDL_UDEV_DEVICE_MOUSE | SDL_UDEV_DEVICE_TOUCHSCREEN | SDL_UDEV_DEVICE_TOUCHPAD)) {
+            SDL_EVDEV_device_added(path, devclass);
+        }
+    }
+
+    closedir(dir);
+}
+#endif /* !SDL_USE_LIBUDEV */
+
 int SDL_EVDEV_Init(void)
 {
     if (!_this) {
@@ -207,7 +258,8 @@ int SDL_EVDEV_Init(void)
                     }
                 }
             } else {
-                /* TODO: Scan the devices manually, like a caveman */
+                /* No udev (the MiSTer FPGA's Linux): every event device, classified by what it reports */
+                SDL_EVDEV_ScanDevices();
