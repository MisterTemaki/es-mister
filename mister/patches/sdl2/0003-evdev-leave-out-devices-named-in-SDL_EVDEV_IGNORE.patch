diff --git a/src/core/linux/SDL_evdev.c b/src/core/linux/SDL_evdev.c
--- a/src/core/linux/SDL_evdev.c
+++ b/src/core/linux/SDL_evdev.c
@@ -163,6 +163,28 @@
 #ifndef SDL_USE_LIBUDEV
 #include <dirent.h>
 
+/* A device whose name holds one of SDL_EVDEV_IGNORE's (comma separated): left out. On the MiSTer FPGA,
+   Main_MiSTer's and Zaparoo's virtual keyboards repeat a joystick's presses as keys. */
+static SDL_bool SDL_EVDEV_IsIgnored(const char *name)
+{
+    const char *list = SDL_getenv("SDL_EVDEV_IGNORE");
+    char item[128];
+
+    while (list && *list) {
+        const char *end = SDL_strchr(list, ',');
+        size_t length = end ? (size_t)(end - list) : SDL_strlen(list);
+        if (length > 0 && length < sizeof(item)) {
+            SDL_memcpy(item, list, length);
+            item[length] = '\0';
+            if (SDL_strstr(name, item) != NULL) {
+                return SDL_TRUE;
+            }
+        }
+        list = end ? end + 1 : NULL;
+    }
+    return SDL_FALSE;
+}
+
 /* The keyboards, mice and touch devices in /dev/input, found as udev would find them */
 static void SDL_EVDEV_ScanDevices(void)
 {
@@ -191,6 +213,15 @@
             continue;
         }
 
+        {
+            char name[128] = "";
+            ioctl(fd, EVIOCGNAME(sizeof(name) - 1), name);
+            if (SDL_EVDEV_IsIgnored(name)) {
+                close(fd);
+                continue;
+            }
+        }
